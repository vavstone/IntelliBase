# Корневой Settings
APP_NAME=llm-service
DEBUG=false
CORS_ORIGINS=["http://localhost:3000"]
# Адреса docker-сервисов для запуска приложения НА ХОСТЕ (в контейнере compose
# подменяет их на имена сервисов). На Windows с Docker Desktop `localhost` уходит
# сначала в IPv6 (::1) — этот проброс идёт через wslrelay и изредка «залипает»
# (запрос висит до таймаута при живом сервисе), поэтому здесь 127.0.0.1.
REDIS_URL=redis://127.0.0.1:6379/0
CACHE_TTL_SECONDS=3600
# Прокси для внешних API (OpenAI/OpenRouter). Заполнить при использовании
# прокси, иначе оставить пустым. DeepSeek прокси не требует — запросы к нему
# идут напрямую (через прокси он падает на проверке TLS-сертификата).
PROXY_URL=

# LLMSettings (env_prefix="LLM_", nested через "__")
LLM__OPENAI_API_KEY=sk-...
LLM__OPENROUTER_API_KEY=sk-...
LLM__OLLAMA_BASE_URL=http://localhost:11434/v1
LLM__OPENAI_BASE_URL=https://api.openai.com/v1
LLM__OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# DeepSeek — OpenAI-совместимый эндпоинт, работает без VPN (альтернатива OpenAI).
# Сейчас используется как судья RAGAS (см. EVAL_JUDGE_*); подключение к /chat
# и RAG-генерации — в планах.
LLM__DEEPSEEK_API_KEY=sk-...
LLM__DEEPSEEK_BASE_URL=https://api.deepseek.com
# Провайдер чата по умолчанию:
#   ollama    — локально, без ключей (на CPU медленно: минуты на ответ);
#   deepseek  — облако без VPN, нужен LLM__DEEPSEEK_API_KEY (быстро даже без GPU);
#   openai / openrouter — облако, нужны соответствующие ключи.
LLM__DEFAULT_PROVIDER=ollama
LLM__DEFAULT_MODEL=gemma3:4b
# LLM__DEFAULT_PROVIDER=deepseek
# LLM__DEFAULT_MODEL=deepseek-v4-flash
# LLM__DEFAULT_MODEL=gpt-4.1-nano
# LLM__DEFAULT_MODEL=gemma3:1b
# LLM__DEFAULT_MODEL=google/gemini-2.0-flash-exp:free
LLM__REQUEST_TIMEOUT=30.0
LLM__MAX_RETRIES=3
# Резерв на случай недоступности основного провайдера (нет сети, таймаут, 429,
# протухший ключ): запрос уходит на него вместо ошибки. Действует в чате, в
# синтезе RAG и у агента. Пустое значение выключает подмену; если резерв
# совпал с основным провайдером — он тоже не сработает.
# Модель задаётся отдельно: имена у провайдеров разные.
LLM__FALLBACK_PROVIDER=ollama
LLM__FALLBACK_MODEL=qwen2.5:3b

# === Embedding settings ===
# Провайдер: sentence_transformers (локально) или openai (облако)
EMBEDDING_PROVIDER=sentence_transformers
# Модель: intfloat/multilingual-e5-large (русский, self-hosted) или text-embedding-3-small (OpenAI)
EMBEDDING_MODEL=intfloat/multilingual-e5-large
# Размер батча: 16–32 для ST на CPU, 100–512 для OpenAI
EMBEDDING_BATCH_SIZE=32
# Директория для diskcache (persistent between restarts)
EMBEDDING_CACHE_DIR=./var/embedding_cache
# Число повторных попыток при сетевых ошибках
EMBEDDING_MAX_RETRIES=5

# === Chat storage ===
# Подключение к Postgres (async-драйвер asyncpg)
DATABASE_URL=postgresql+asyncpg://chat:pswd@127.0.0.1:5432/intellibase
# Пароль базы (используется в docker compose для POSTGRES_PASSWORD)
POSTGRES_PASSWORD=pswd
# Какую реализацию репозитория использовать: json | postgres
CHAT_REPOSITORY=json
# Куда писать JSONL-файлы при CHAT_REPOSITORY=json
CHAT_STORAGE_DIR=./var/chats
# Размер sliding window (сколько последних сообщений берём в контекст)
CHAT_CONTEXT_WINDOW=10

# === Telegram bot ===
BOT_TOKEN=                       # токен от @BotFather
BACKEND_URL=http://app:8000
BOT_ADMIN_IDS=                   # comma-separated Telegram user IDs, например: 12345,67890

# для тестов (закомментировать для прода, хотя и не повлияет):
DATABASE_URL_FOR_TESTS=postgresql+asyncpg://chat:pswd@127.0.0.1:5432/intellibase_test

# === Service-to-service (POST /notify: backend → bot) ===
INTERNAL_TOKEN=change-me-with-openssl-rand-hex-32
# URL bot-сервера (backend шлёт сюда /notify). В Docker — http://bot:9000, локально — http://localhost:9000
BOT_URL=http://127.0.0.1:9000
# Порт, на котором бот поднимает HTTP-сервер для /notify
BOT_API_PORT=9000

# === Admin / production ===
# X-Admin-Token для /chats/admin/* (stats, broadcast, export, handoff, alerts).
# Сгенерировать: openssl rand -hex 32
ADMIN_TOKEN=change-me-with-openssl-rand-hex-32
# Telegram chat_id админ-группы для alert drain (бот шлёт алерты сюда)
ADMIN_CHAT_ID=
# Включить OpenAI Moderation API (omni-moderation-latest)
MODERATION_USE_OPENAI=true
# Rate limit: сколько сообщений на owner_external_id в минуту
RATE_LIMIT_MESSAGES_PER_MIN=15

# === Qdrant vector store ===
QDRANT_URL=http://127.0.0.1:6333
# Ключ API для Qdrant (в dev не требуется — Qdrant без аутентификации).
# В production: задать `openssl rand -hex 32` и раскомментировать environment в compose.
# QDRANT_API_KEY=
QDRANT_COLLECTION=documents
EMBEDDING_DIM=1024                       # intfloat/multilingual-e5-large

# === RAG (LlamaIndex) ===
# Корпус для индексации: data/<корпус>/<category>/... (PDF/DOCX/HTML/MD).
# По умолчанию — демонстрационный корпус из репозитория (18 синтетических
# документов, пересобрать: `uv run python scripts/generate_demo_corpus.py`).
# Для рабочего корпуса укажите RAG_DATA_DIR=data/kb (в git не хранится).
RAG_DATA_DIR=data/demo_kb
# Коллекция LlamaIndex (офлайн IngestionPipeline пишет, онлайн /rag/query читает)
# и отдельная коллекция для bare-metal сравнения (Б5.3). Демо-корпус пишется
# в rag_demo — рабочая коллекция rag_block_05 при этом не затрагивается.
RAG_COLLECTION=rag_demo
RAG_COLLECTION_BARE=rag_block_03_bare
# Дочерний docstore на диске — состояние инкрементальной индексации (UPSERTS).
RAG_DOCSTORE_PATH=var/rag_docstore.json
# LLM для генерации RAG-ответа. Варианты:
#   ollama   — локально, без ключей (нужна запущенная Ollama; на GPU быстро, на CPU медленно);
#   deepseek — облако, быстро и без VPN, нужен LLM__DEEPSEEK_API_KEY;
#   openai   — облако, нужен LLM__OPENAI_API_KEY.
RAG_LLM_PROVIDER=ollama
# Модель под выбранного провайдера: qwen3:8b (ollama) / deepseek-v4-flash / gpt-4o-mini.
# Выбор Б5.6: qwen3:8b даёт faithfulness 0.775 против 0.666 у gemma3:4b.
RAG_LLM_MODEL=qwen3:8b
# Таймаут генерации RAG-ответа (сек). qwen3:8b на CPU медленная: ~2–4 мин на ответ.
RAG_LLM_TIMEOUT=600
# Контекстное окно LLM (токенов). Для RAG-контекста (top-5 чанков) 8192 достаточно.
RAG_LLM_CONTEXT_WINDOW=32000
# Ширина retrieval (similarity_top_k): достаём широко, в промпт уходит top-N.
# ДЗ 5.4: top-K=10 даёт полный recall (top-K=20 прироста не даёт).
RAG_TOP_K=10
# Параметры чанкинга (ДЗ 5.4: 512/64 — лучший конфиг).
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
# Движок извлечения текста из PDF (офлайн-контур индексации).
# inspector — pdf-inspector (Rust): постраничная классификация scanned/text_based
#   + markdown с таблицами; на замерах ~×35 быстрее pymupdf4llm.
# pymupdf — PyMuPDFReader (legacy-откат).
# Сканы не читает ни один: страницы без текстового слоя пропускаются (нужен OCR).
RAG_PDF_PARSER=inspector
# Если top-1 score ниже порога — ответа в корпусе нет, отдаём честный отказ
# БЕЗ вызова LLM. Для E5 косинус сжат (релевантное ~0.84, off-topic ~0.76),
# поэтому 0.80 — зазор. Для OpenAI-эмбеддингов калибруйте заново (см. docs/rag.md).
# Демо-корпус: замер 02.10 по 27 вопросам датасета и 5 off-topic — в базе
# 0.795…0.911, вне базы 0.695…0.766; порог 0.78 посередине зазора.
RAG_SCORE_THRESHOLD=0.78
# === Re-ranker (ДЗ 5.4) ===
# Опциональный cross-encoder поверх bi-encoder поиска: пересортировывает
# top-K (RAG_TOP_K) кандидатов и оставляет top-N в промпт. Скачивается ~2.2 ГБ.
RAG_RERANK_ENABLED=false
RAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3
RAG_RERANK_TOP_N=5
# === Диалоговый RAG (Б5.5) ===
# Включать retrieval + цитаты в /chats/{id}/messages, когда RAG-сервис доступен.
# False — /chats остаётся чистым LLM-чатом (M4).
RAG_ENABLE_CHAT=true
# Condense: переписывать follow-up в самодостаточный поисковый запрос (один
# LLM-вызов) при наличии истории — чинит поиск на коротких follow-up.
RAG_CONDENSE_ENABLED=true

# === Phoenix-трейсинг (опционально, группа `tracing`) ===
# Инструментирование OpenAI/LangChain/LlamaIndex в Phoenix (трейсы LLM, RAG, агента).
# По умолчанию выключено — сервис работает без трейсинга. Для запуска на хосте
# включить: PHOENIX_ENABLED=true + uv sync --extra tracing (и поднятый phoenix:
# http://localhost:6006). В контейнере флаг и gRPC-эндпоинт ставит compose.yaml,
# а образ уже собран с `--extra tracing` — править здесь ничего не нужно.
PHOENIX_ENABLED=false
PHOENIX_COLLECTOR_ENDPOINT=http://127.0.0.1:6006/v1/traces
# Пути, исключённые из трейсинга: healthcheck'и стучатся раз в 30 с и вытесняют
# осмысленные трейсы из списка.
PHOENIX_EXCLUDED_URLS=/health,/ready,/openapi.json,/docs,/redoc

# === Оценка качества RAGAS (опционально, группа `eval`) ===
# Судья метрик отделён от RAG-LLM (RAG_LLM_MODEL): роли разные.
# Нужен только для scripts/run_eval.py и scripts/generate_testset.py.
# Провайдер судьи: deepseek (без VPN) / openai / anthropic.
EVAL_JUDGE_PROVIDER=deepseek
EVAL_JUDGE_MODEL=deepseek-v4-flash
# Для EVAL_JUDGE_PROVIDER=anthropic — раскомментировать:
# ANTHROPIC_API_KEY=sk-ant-...

# === Агентный слой (LangGraph) ===
# Где хранить чек-пойнты графа: memory | sqlite | postgres.
# sqlite — локальная разработка; postgres — в docker-compose (тот же PG, что у FastAPI).
AGENT_CHECKPOINTER=sqlite
# URI для AsyncPostgresSaver (требует psycopg v3, НЕ asyncpg). Нужен при AGENT_CHECKPOINTER=postgres.
AGENT_CHECKPOINTER_POSTGRES_URI=postgresql://chat:pswd@127.0.0.1:5432/intellibase
# Файл SQLite-чекпоинтера при AGENT_CHECKPOINTER=sqlite.
AGENT_SQLITE_PATH=var/agent_checkpoints.sqlite
# Bootstrap-список разрешённых пользователей бота (chat_id через запятую).
# Основной список живёт в БД (таблица bot_users, админ-API /chats/admin/bot-users),
# там же хранятся имена для «отправь Иванову». Эта переменная нужна, когда таблица
# пуста (чистый клон: бот закрыт для всех, первый администратор должен откуда-то
# взяться) и как аварийный доступ, если список в БД испорчен.
# Пусто + пустая таблица = бот не отвечает никому.
# BOT_ALLOWED_CHAT_IDS=123456789,987654321

# === Кэш моделей HuggingFace ===
# HF_HUB_OFFLINE=1 запрещает сетевые обращения к huggingface.co: модель E5 должна
# быть доступна локально. Варианты:
#   1) указать путь к уже скачанному кэшу хоста (быстрый старт, compose монтирует его в app);
#   2) оставить пустым — используется docker-том, модель скачается при первом старте (~2.2 ГБ).
# HF_HUB_OFFLINE=1
# HF_CACHE_DIR=/home/user/.cache/huggingface
#
# Каталог весов для LlamaIndex (в формате HF-кэша). По умолчанию LlamaIndex ищет
# модель в своём кэше (~/.cache/llama_index) — в контейнере он теряется при
# пересоздании, и RAG не поднимается. Для Docker задаётся в compose.yaml:
# EMBEDDING_MODEL_CACHE_DIR=/home/appuser/.cache/huggingface/hub
# EMBEDDING_MODEL_CACHE_DIR=/home/user/.cache/huggingface/hub
